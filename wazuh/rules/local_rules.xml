<group name="local,syslog,sshd,fim,honeypot,">

  <!-- ==================================================================== -->
  <!-- 1. Integrity & Persistence Detection Rules (FIM)                    -->
  <!-- ==================================================================== -->

  <!-- Rule 100050: Critical modifications to identity / network configs -->
  <rule id="100050" level="12">
    <if_sid>550</if_sid>
    <match>/etc/passwd|/etc/shadow|/etc/sudoers|/etc/netplan</match>
    <description>Critical Alert: Unexpected modification in identity or network configuration files!</description>
    <mitre>
      <id>T1484</id>
    </mitre>
    <info type="link">https://attack.mitre.org/techniques/T1484/</info>
  </rule>

  <!-- Rule 100051: Unauthorized binary injected into system executable paths -->
  <rule id="100051" level="10">
    <if_sid>554</if_sid>
    <match>/usr/bin/|/usr/sbin/|/bin/|/sbin/</match>
    <description>Suspicious Behavior: New executable binary injected into critical system paths.</description>
    <mitre>
      <id>T1036</id>
    </mitre>
    <info type="link">https://attack.mitre.org/techniques/T1036/</info>
  </rule>

  <!-- Rule 100052: Critical file deletion in critical configuration directories -->
  <rule id="100052" level="11">
    <if_sid>553</if_sid>
    <match>/etc/|/boot/|/var/log/</match>
    <description>High Alert: Critical file removed or anti-forensic log deletion attempted.</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

  <!-- ==================================================================== -->
  <!-- 2. Cowrie Honeypot & Adaptive Deception Rules                        -->
  <!-- ==================================================================== -->

  <!-- Rule 100060: Attacker session initiated on Cowrie Honeypot -->
  <rule id="100060" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.connect</field>
    <description>Deception Alert: Attacker connected to Cowrie Deception Honeypot.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Rule 100061: Unauthorized command execution inside Honeypot sandbox -->
  <rule id="100061" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.command.input</field>
    <description>Critical Deception Alert: Command executed in honeypot environment.</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Rule 100062: Attacker file download / payload delivery in Honeypot -->
  <rule id="100062" level="13">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.file_download</field>
    <description>Critical Deception Alert: Inbound malware payload downloaded inside honeypot!</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- ==================================================================== -->
  <!-- 3. Adaptive Honey-Token Detection                                    -->
  <!-- ==================================================================== -->

  <!-- Rule 100070: Honey-Token Access Detected -->
  <rule id="100070" level="14">
    <if_sid>550</if_sid>
    <match>adaptive_honey_token.env</match>
    <description>Deception High-Fidelity Alert: Decoy honey-token credentials accessed!</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- ==================================================================== -->
  <!-- 4. Brute Force & Authentication Anomaly Detection                   -->
  <!-- ==================================================================== -->

  <!-- Rule 100080: Correlation rule for rapid SSH brute-force -->
  <rule id="100080" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH Brute-Force: Excessive failed logins detected from single host.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
