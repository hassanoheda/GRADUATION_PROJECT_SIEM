! ==============================================================================
! Cisco IOS Configuration for Router R1 (AI-Driven SOC Topology)
! Project: Proactive SIEM System Based on Adaptive Deception Environments
! Institution: University of Tripoli - Faculty of Information Technology
! Description: Edge Router connecting SOC Management, Victim DMZ, and Attack Lab
! ==============================================================================

enable
configure terminal

hostname R1
ip domain-name soc-pipeline.local

! --- User Credentials for Netmiko Automated Mitigation ---
username admin privilege 15 secret admin
enable secret admin

! --- SSH Configuration ---
crypto key generate rsa general-keys modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3

! --- Interface FastEthernet0/0 -> Wazuh Manager (VMnet1) ---
interface FastEthernet0/0
 description WAZUH_MANAGER_SEGMENT
 ip address 10.10.10.254 255.255.255.0
 no shutdown
 exit

! --- Interface FastEthernet1/0 -> Employees Internal LAN ---
interface FastEthernet1/0
 description EMPLOYEES_LAN
 ip address 192.168.10.254 255.255.255.0
 no shutdown
 exit

! --- Interface FastEthernet2/0 -> Target Victim Server / Honeypot (VMnet2) ---
interface FastEthernet2/0
 description VICTIM_SERVER_SEGMENT
 ip address 10.0.0.254 255.255.255.0
 no shutdown
 exit

! --- Interface FastEthernet3/0 -> Kali Attacker Machine (VMnet3) ---
interface FastEthernet3/0
 description ATTACKER_SEGMENT
 ip address 192.168.52.254 255.255.255.0
 no shutdown
 exit

! --- Access List for Dynamic Automated Threat Mitigation ---
! brain.py dynamically injects deny entries into AI_BLOCK_LIST via Netmiko
ip access-list extended AI_BLOCK_LIST
 99999 permit ip any any
 exit

! Apply initial access-group on all interfaces
interface FastEthernet0/0
 ip access-group AI_BLOCK_LIST in
 exit
interface FastEthernet1/0
 ip access-group AI_BLOCK_LIST in
 exit
interface FastEthernet2/0
 ip access-group AI_BLOCK_LIST in
 exit
interface FastEthernet3/0
 ip access-group AI_BLOCK_LIST in
 exit

! --- VTY Lines for Netmiko Automation Access ---
line vty 0 4
 login local
 transport input ssh
 exec-timeout 15 0
 exit

end
write memory
